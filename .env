# Copy to .env

PORT=3000

REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_this_with_a_long_random_secret

# ---------------- Token lifetimes (seconds) ----------------
# Layer 1: Session - hard 3 hour ceiling, non-negotiable
SESSION_TTL_SECONDS=10800

# Session JWT rotates every 15.5 minutes (client-driven, does not reset SESSION_TTL_SECONDS)
REFRESH_INTERVAL_SECONDS=930

# Layer 2: Tab - one issued per browser tab, lives as long as the tab reasonably could
TAB_TOKEN_TTL_SECONDS=1800

# Layer 3: Page - reissued on EVERY page/route navigation inside a tab. Kept short
# on purpose: shorter window = less time for a stolen token to be replayed.
PAGE_TOKEN_TTL_SECONDS=90

# Layer 4: Action/Instruction - reissued on every sensitive user action
# (form submit, button click before payment, etc). Deliberately very short.
ACTION_TOKEN_TTL_SECONDS=20

# Layer 5: Transaction nonce - one-time use, dies immediately after consumption anyway
TRANSACTION_NONCE_TTL_SECONDS=60
